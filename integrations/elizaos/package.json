{
  "name": "@agent-world-kit/plugin-elizaos",
  "version": "0.1.0",
  "description": "elizaOS actions and context provider for Agent World Kit.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "keywords": ["elizaos", "plugin", "interactive-fiction", "worldbuilding"],
  "peerDependencies": {
    "@elizaos/core": "^1.7.2"
  },
  "devDependencies": {
    "@elizaos/core": "1.7.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run typecheck && npm run build"
  }
}
