# The demo adapter works without keys and is the default.
WORLDKIT_MODEL_PROVIDER=demo

# Any OpenAI-compatible chat-completions endpoint can power the kit.
# WORLDKIT_MODEL_PROVIDER=openai-compatible
# WORLDKIT_API_KEY=
# WORLDKIT_BASE_URL=https://api.openai.com/v1
# WORLDKIT_MODEL=gpt-4.1-mini

WORLDKIT_PORT=4317
WORLDKIT_HOST=127.0.0.1
WORLDKIT_DATA_DIR=.agent-worlds
